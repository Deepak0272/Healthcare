# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g., mongodb://localhost:27017/healthtech)
# If empty or connection fails, the backend will automatically spin up an embedded MongoMemoryServer
MONGODB_URI=mongodb://127.0.0.1:27017/healthtech

# JWT Authentication
JWT_SECRET=health_tech_secure_jwt_secret_key_2026_super_safe
JWT_EXPIRE=30d

# Admin Secret Registration Key
ADMIN_SECRET=HEALTH_TECH_ADMIN_2026

# Email Notification / SMTP Service (Optional - Leave blank for automatic interactive Demo Simulation Mode)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_SECURE=false
SMTP_FROM=alerts@healthtech.local
